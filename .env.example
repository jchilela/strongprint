# Copiar para .env (make env). Valores de desenvolvimento apenas — em produção
# todos os segredos vêm do ambiente do servidor.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

DATABASE_URL=postgres://strongprint:strongprint@db:5432/strongprint
REDIS_URL=redis://redis:6379/0

# Armazenamento S3 (SeaweedFS em desenvolvimento)
S3_ENDPOINT_URL=http://s3:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY_ID=devaccess
S3_SECRET_ACCESS_KEY=devsecret-change-me
S3_BUCKET=strongprint-jobs
S3_REGION=us-east-1

# Gateway de impressora por omissão: fake | ipp
PRINTER_GATEWAY=fake

# Regras de negócio
JOB_SESSION_TIMEOUT_MINUTES=10
FILE_RETENTION_HOURS=24
