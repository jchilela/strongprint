#!/usr/bin/env bash
# Encaminha o IP da impressora na VPN (10.77.N.2) para o IP dela na rede local.
# Reexecutável: as regras ficam em cadeias próprias que são limpas a cada execução.
set -euo pipefail
source /etc/strongprint/agent.env
sysctl -q -w net.ipv4.ip_forward=1

chain() {  # chain <tabela> <cadeia própria> <cadeia do sistema>
    iptables -t "$1" -N "$2" 2>/dev/null || iptables -t "$1" -F "$2"
    iptables -t "$1" -C "$3" -j "$2" 2>/dev/null || iptables -t "$1" -I "$3" -j "$2"
}

# Versão anterior (uma só cadeia "STRONGPRINT"): remover.
for spec in "nat PREROUTING" "nat POSTROUTING" "filter FORWARD"; do
    set -- $spec
    while iptables -t "$1" -D "$2" -j STRONGPRINT 2>/dev/null; do :; done
done
iptables -t nat -F STRONGPRINT 2>/dev/null && iptables -t nat -X STRONGPRINT 2>/dev/null || true
iptables -F STRONGPRINT 2>/dev/null && iptables -X STRONGPRINT 2>/dev/null || true

chain nat SP_PRE PREROUTING
chain nat SP_POST POSTROUTING
chain filter SP_FWD FORWARD

# Impressora ligada por cabo diretamente ao Pi: rota só para ela por essa interface,
# usando o IP do Pi na rede local como origem (a impressora não tem outro caminho).
if [[ -n ${PRINTER_LAN_IP:-} && -n ${PRINTER_IFACE:-} ]]; then
    SRC=$(ip route get 1.1.1.1 | grep -oP 'src \K\S+')
    ip link set "$PRINTER_IFACE" up
    ip route replace "$PRINTER_LAN_IP/32" dev "$PRINTER_IFACE" src "$SRC"
fi

if [[ -n ${PRINTER_LAN_IP:-} && -n ${PRINTER_VPN_IP:-} ]]; then
    OUT=$(ip route get "$PRINTER_LAN_IP" | grep -oP 'dev \K\S+')
    iptables -t nat -A SP_PRE -i wgsp -d "$PRINTER_VPN_IP" -j DNAT --to-destination "$PRINTER_LAN_IP"
    iptables -t nat -A SP_POST -o "$OUT" -d "$PRINTER_LAN_IP" -j MASQUERADE
    # Só o servidor (pela VPN) chega à impressora, e só aos serviços necessários:
    # IPP (631), EWS/eSCL (80/443/8080) e SNMP (161).
    for rule in "-p tcp --dport 631" "-p tcp --dport 443" "-p tcp --dport 80" \
                "-p tcp --dport 8080" "-p udp --dport 161"; do
        iptables -A SP_FWD -i wgsp -d "$PRINTER_LAN_IP" $rule -j ACCEPT
    done
    iptables -A SP_FWD -i wgsp -d "$PRINTER_LAN_IP" -j DROP
    iptables -A SP_FWD -o wgsp -s "$PRINTER_LAN_IP" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
fi
echo "strongprint-nat: ${PRINTER_VPN_IP:-?} -> ${PRINTER_LAN_IP:-(sem impressora)} ${PRINTER_IFACE:+via $PRINTER_IFACE}"
